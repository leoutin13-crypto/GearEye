# Copia este archivo a %LOCALAPPDATA%\GearEye\.env y cambia la URL por tu PostgreSQL local.
# Si tu contrasena contiene caracteres especiales, codificalos para URL.
GEAREYE_DATABASE_URL=postgresql://geareye_app:CAMBIA_ESTA_CLAVE@localhost:5432/geareye

# Enlace HTTPS publico que abriran los administradores invitados y los agentes remotos.
# Registra un dominio, apunta su DNS al servidor GearEye y configura HTTPS en el proxy/hosting.
# Sustituye este ejemplo en el archivo privado %LOCALAPPDATA%\GearEye\.env.
GEAREYE_PUBLIC_URL=https://geareye.tu-dominio.com
# Invitaciones por correo; se aceptan correos de cualquier dominio.
GEAREYE_SMTP_HOST=smtp.tu-proveedor.com
GEAREYE_SMTP_PORT=587
GEAREYE_SMTP_USER=usuario-smtp
GEAREYE_SMTP_PASSWORD=CAMBIA_ESTA_CLAVE
GEAREYE_SMTP_FROM=GearEye <no-reply@tu-dominio.com>
GEAREYE_SMTP_STARTTLS=true

# Opcional: ruta donde GearEye mantiene auth_state.json y history.sqlite3.
# GEAREYE_DATA_DIR=C:/Users/TU_USUARIO/AppData/Local/GearEye
