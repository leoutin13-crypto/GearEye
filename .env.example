# Copia este archivo a %LOCALAPPDATA%\GearEye\.env y cambia la URL por tu PostgreSQL local.
# Si tu contrasena contiene caracteres especiales, codificalos para URL.
GEAREYE_DATABASE_URL=postgresql://geareye_app:CAMBIA_ESTA_CLAVE@localhost:5432/geareye

# Enlace HTTPS publico que abriran los administradores invitados y los agentes remotos.
# Registra un dominio, apunta su DNS al servidor GearEye y configura HTTPS en el proxy/hosting.
# Sustituye este ejemplo en el archivo privado %LOCALAPPDATA%\GearEye\.env.
GEAREYE_PUBLIC_URL=https://geareye.tu-dominio.com
# Invitaciones por correo; se aceptan correos de cualquier dominio.
GEAREYE_SMTP_HOST=smtp.tu-proveedor.com
GEAREYE_SMTP_PORT=587
GEAREYE_SMTP_USER=usuario-smtp
GEAREYE_SMTP_PASSWORD=CAMBIA_ESTA_CLAVE
GEAREYE_SMTP_FROM=GearEye <no-reply@tu-dominio.com>
GEAREYE_SMTP_STARTTLS=true

# Opcional: ruta donde GearEye mantiene auth_state.json y history.sqlite3.
# GEAREYE_DATA_DIR=C:/Users/TU_USUARIO/AppData/Local/GearEye

# Opcional: consulta LLDP de switches gestionables. Estas variables van en el
# entorno privado del agente instalado dentro de la LAN que se desea mapear.
# El agente también lee desde este archivo la URL central y el token entregado
# al administrador de la empresa durante la invitación:
# GEAREYE_SERVER_URL=https://geareye.tu-dominio.com
# GEAREYE_AGENT_TOKEN=PEGA_AQUI_EL_TOKEN_PRIVADO
# Habilita LLDP en los switches y crea credenciales SNMP de solo lectura.
# Es preferible SNMPv3 con autenticación SHA-256 y privacidad AES-128:
# GEAREYE_SNMP_VERSION=3
# GEAREYE_SNMP_V3_USER=usuario_solo_lectura
# GEAREYE_SNMP_V3_AUTH_KEY=CAMBIA_ESTA_CLAVE
# GEAREYE_SNMP_V3_PRIV_KEY=CAMBIA_ESTA_CLAVE
# Si el equipo solo permite SNMPv1/v2c, configura una comunidad de solo lectura
# y restringe UDP 161 a la IP del agente:
# GEAREYE_SNMP_VERSION=2c
# GEAREYE_SNMP_COMMUNITY=CAMBIA_ESTA_COMUNIDAD
# Puedes fijar las IP de administración de switches separados por coma cuando
# su fabricante no pueda inferirse desde la MAC:
# GEAREYE_SNMP_TARGETS=192.168.1.2,192.168.1.3
