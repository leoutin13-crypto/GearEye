# Copy this file to .env on the Proxmox VM. Never commit the real .env.
GEAREYE_DB_ADMIN_PASSWORD=replace_with_64_hex_characters
GEAREYE_DB_PASSWORD=replace_with_another_64_hex_characters

# Set this to the exact public HTTPS hostname configured in Cloudflare Tunnel.
GEAREYE_PUBLIC_URL=https://geareye.example.com

# Create a Cloudflare Tunnel for the hostname above and paste its connector token.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token

# Use SMTP credentials from your mail provider; invitations can go to any domain.
GEAREYE_SMTP_HOST=smtp.example.com
GEAREYE_SMTP_PORT=587
GEAREYE_SMTP_USER=no-reply@example.com
GEAREYE_SMTP_PASSWORD=replace_with_smtp_password
GEAREYE_SMTP_FROM=GearEye <no-reply@example.com>
GEAREYE_SMTP_STARTTLS=true
